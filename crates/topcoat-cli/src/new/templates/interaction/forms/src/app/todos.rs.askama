pub mod id;

use serde::Deserialize;
use topcoat::{
    Result,
    context::Cx,
    router::{
        content::Form,
        error::{SeeOther, see_other},
        href, page, route,
    },
    view::{View, view},
};

use crate::features::todo::Todo;

#[page{{ paths.page("/todos") }}]
pub async fn page(cx: &Cx) -> Result<impl View> {
    let todos = Todo::list(cx).await?;

    Ok(view! {
        <main{{ classes.main }}>
            <h1{{ classes.heading }}>"Todos"</h1>
            <form{{ classes.paragraph }} method="post" action=(href!(create))>
                <input{{ classes.input }} type="text" name="title" placeholder="What needs doing?" required="">
                " "
                <button{{ classes.button }} type="submit">"Add"</button>
            </form>
            if todos.is_empty() {
                <p{{ classes.paragraph }}>"Nothing to do."</p>
            } else {
                <ul{{ classes.list }}>
                    for todo in todos {
                        <li{{ classes.item }}>
                            <form method="post" action=(href!(id::toggle, id::Id(todo.id)))>
                                <button{{ classes.button }} type="submit">
                                    if todo.done { "Undo" } else { "Done" }
                                </button>
                            </form>
                            if todo.done {
                                <s>(&todo.title)</s>
                            } else {
                                <span>(&todo.title)</span>
                            }
                            <form method="post" action=(href!(id::delete, id::Id(todo.id)))>
                                <button{{ classes.button }} type="submit">"Delete"</button>
                            </form>
                        </li>
                    }
                </ul>
            }
        </main>
    })
}

/// The fields of the form that adds a todo.
#[derive(Deserialize)]
pub struct NewTodo {
    title: String,
}

#[route{{ paths.route("POST", "/todos") }}]
pub async fn create(cx: &Cx, Form(new_todo): Form<NewTodo>) -> Result<SeeOther> {
    let title = new_todo.title.trim();
    if !title.is_empty() {
        Todo::add(cx, title).await?;
    }

    // Redirect back to the list so a reload does not submit the form again.
    Ok(see_other(href!(page).resolve(cx)))
}
