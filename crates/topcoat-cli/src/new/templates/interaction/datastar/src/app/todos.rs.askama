pub mod id;

use serde::Deserialize;
use topcoat::{
    Result,
    context::Cx,
    datastar::{PatchElements, Signals},
    router::{href, page, route},
    view::{View, ViewExt, component, view},
};

use crate::features::todo::Todo;

#[page{{ paths.page("/todos") }}]
pub async fn page() -> Result<impl View> {
    Ok(view! {
        <main{{ classes.main }} data-signals:title="''">
            <h1{{ classes.heading }}>"Todos"</h1>
            // Datastar sends the signals to `create`, then clears the input.
            <form
                {{- classes.paragraph }}
                data-on:submit__prevent=(("@post('", href!(create), "'); $title = ''"))
            >
                <input{{ classes.input }} type="text" data-bind:title="" placeholder="What needs doing?" required="">
                " "
                <button{{ classes.button }} type="submit">"Add"</button>
            </form>
            todo_list()
        </main>
    })
}

/// The todo list. Each route sends it back so Datastar can morph the list on the page.
#[component]
pub async fn todo_list(cx: &Cx) -> Result<impl View> {
    let todos = Todo::list(cx).await?;

    Ok(view! {
        <div id="todos">
            if todos.is_empty() {
                <p{{ classes.paragraph }}>"Nothing to do."</p>
            } else {
                <ul{{ classes.list }}>
                    for todo in todos {
                        <li{{ classes.item }}>
                            <button
                                {{- classes.button }}
                                data-on:click=(("@patch('", href!(id::toggle, id::Id(todo.id)), "')"))
                            >
                                if todo.done { "Undo" } else { "Done" }
                            </button>
                            if todo.done {
                                <s>(&todo.title)</s>
                            } else {
                                <span>(&todo.title)</span>
                            }
                            <button
                                {{- classes.button }}
                                data-on:click=(("@delete('", href!(id::delete, id::Id(todo.id)), "')"))
                            >
                                "Delete"
                            </button>
                        </li>
                    }
                </ul>
            }
        </div>
    })
}

/// Renders the todo list as a Datastar patch for the element with its id.
pub async fn patch_todo_list(cx: &Cx) -> Result<PatchElements> {
    let list = view! { cx => todo_list() }.single().await?;
    Ok(PatchElements::new(list.render(cx)))
}

/// The signals the page declares.
#[derive(Deserialize)]
pub struct NewTodo {
    title: String,
}

#[route{{ paths.route("POST", "/todos") }}]
pub async fn create(cx: &Cx, Signals(new_todo): Signals<NewTodo>) -> Result<PatchElements> {
    let title = new_todo.title.trim();
    if !title.is_empty() {
        Todo::add(cx, title).await?;
    }
    patch_todo_list(cx).await
}
