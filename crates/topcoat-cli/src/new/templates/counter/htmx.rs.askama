use std::sync::atomic::{AtomicU64, Ordering};

use topcoat::{
    Result,
    context::Cx,
    router::{href, page, route},
    view::{View, ViewExt, ViewHandle, view},
};

/// The number of clicks since the server started.
static COUNT: AtomicU64 = AtomicU64::new(0);

#[page{{ paths.page("/counter") }}]
pub async fn page() -> Result<impl View> {
    let count = COUNT.load(Ordering::Relaxed);

    Ok(view! {
        <main{{ classes.main }}>
            <h1{{ classes.heading }}>"Counter"</h1>
            <p{{ classes.paragraph }}>
                "Count: "
                <span id="count">(count)</span>
            </p>
            // htmx posts to `increment` and swaps the response into #count.
            <button{{ classes.button }} hx-post=(href!(increment)) hx-target="#count">"+"</button>
        </main>
    })
}

#[route{{ paths.route("POST", "/counter") }}]
pub async fn increment(cx: &Cx) -> Result<ViewHandle> {
    let count = COUNT.fetch_add(1, Ordering::Relaxed) + 1;
    Ok(view! { cx => (count) }.single().await?)
}
