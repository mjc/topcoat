use std::sync::atomic::{AtomicU64, Ordering};

use topcoat::{
    Result,
    alpine_ajax::ajax_request,
    context::Cx,
    router::{
        error::see_other,
        href, page,
        response::{IntoResponse, Response},
        route,
    },
    view::{View, ViewExt, view},
};

/// The number of clicks since the server started.
static COUNT: AtomicU64 = AtomicU64::new(0);

#[page{{ paths.page("/counter") }}]
pub async fn page() -> Result<impl View> {
    let count = COUNT.load(Ordering::Relaxed);

    Ok(view! {
        <main{{ classes.main }}>
            <h1{{ classes.heading }}>"Counter"</h1>
            <p{{ classes.paragraph }}>
                "Count: "
                <span id="count">(count)</span>
            </p>
            // Alpine AJAX submits the form in the background and replaces the element whose
            // id matches `x-target`. Without JavaScript, the form submits normally.
            <form method="post" action=(href!(increment)) x-target="count">
                <button{{ classes.button }} type="submit">"+"</button>
            </form>
        </main>
    })
}

#[route{{ paths.route("POST", "/counter") }}]
pub async fn increment(cx: &Cx) -> Result<Response> {
    let count = COUNT.fetch_add(1, Ordering::Relaxed) + 1;

    // An Alpine AJAX request only receives the targeted element.
    if ajax_request(cx) {
        return view! { cx => <span id="count">(count)</span> }
            .single()
            .await?
            .into_response(cx);
    }

    // Without JavaScript, redirect back to the page so a reload does not resubmit.
    see_other(href!(page).resolve(cx)).into_response(cx)
}
