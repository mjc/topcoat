use serde::{Deserialize, Serialize};
use topcoat::{
    Result,
    datastar::{PatchSignals, Signals},
    router::{href, page, route},
    view::{View, view},
};

/// The signals the counter page declares.
#[derive(Deserialize, Serialize)]
pub struct Counter {
    count: u64,
}

#[page{{ paths.page("/counter") }}]
pub async fn page() -> Result<impl View> {
    // Datastar keeps the count in a signal in the browser.
    Ok(view! {
        <main{{ classes.main }} data-signals:count="0">
            <h1{{ classes.heading }}>"Counter"</h1>
            <p{{ classes.paragraph }}>
                "Count: "
                <span data-text="$count"></span>
            </p>
            // Datastar sends the signals to `increment` and merges the response into them.
            <button{{ classes.button }} data-on:click=(("@post('", href!(increment), "')"))>"+"</button>
        </main>
    })
}

#[route{{ paths.route("POST", "/counter") }}]
pub async fn increment(Signals(counter): Signals<Counter>) -> Result<PatchSignals> {
    PatchSignals::json(&Counter {
        count: counter.count + 1,
    })
}
