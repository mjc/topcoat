use topcoat::{
    Result,
    context::Cx,
    router::page,
    runtime::signal,
    view::{View, view},
};

#[page{{ paths.page("/counter") }}]
pub async fn page(cx: &Cx) -> Result<impl View> {
    // The signal lives in the browser. The buttons update it without a request to the
    // server, and the page shows the new value.
    let count = signal(cx, || 0i32);

    Ok(view! {
        <main{{ classes.main }}>
            <h1{{ classes.heading }}>"Counter"</h1>
            <p{{ classes.paragraph }}>
                "Count: "
                $(count.get())
            </p>
            <button{{ classes.button }} @click=$(|_e| count.decrement())>"-"</button>
            " "
            <button{{ classes.button }} @click=$(|_e| count.increment())>"+"</button>
        </main>
    })
}
